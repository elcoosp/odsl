use sea_orm::entity::prelude::*;
#[sea_orm::model]
#[derive(Clone, Debug, PartialEq, DeriveEntityModel, Eq)]
#[sea_orm(table_name = "users")]
pub struct Model {
    #[sea_orm(primary_key)]
    #[sea_orm(auto_increment = false)]
    pub id: uuid::Uuid,
    #[sea_orm(unique)]
    pub email: String,
    pub age: Option<i32>,
}
impl ActiveModelBehavior for ActiveModel {}
